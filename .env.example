# ============================================
# Transcriber Pro — Frontend (Next.js) environment
# ============================================
# Copy this file to .env.local (local dev) or set these in your host's dashboard.
#   cp .env.example .env.local
# The backend (PR2-Sem19/) has its own env.example — set that up too.

# --- Core: talk to the backend ------------------------------------------------
# Where the Python/FastAPI backend is reachable from the Next.js server.
# Local dev: http://localhost:8000   On one Render service: http://localhost:8000
BACKEND_URL=http://localhost:8000

# The API key the frontend uses to call the backend. Must match one of the
# backend's API_KEYS. Generate one and paste the same value both places.
NEXT_PUBLIC_API_KEY=

# --- Auth (Better Auth) -------------------------------------------------------
# Public URL of the app (used to build sign-in links). Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# A long random secret for signing sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same Postgres connection string as the backend's DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Google sign-in (optional) ------------------------------------------------
# Leave blank to offer email sign-in only. To enable Google, create OAuth
# credentials at https://console.cloud.google.com and paste them here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email sending for verification (optional) --------------------------------
# Uses Resend (https://resend.com). Leave blank to skip email verification.
RESEND_API_KEY=
SENDER_EMAIL=noreply@example.com
SENDER_NAME=Transcriber Pro

# --- Anti-abuse (optional) ----------------------------------------------------
# Random salt used to hash signup IPs. Generate: openssl rand -hex 16
SIGNUP_IP_SALT=
