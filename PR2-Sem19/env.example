# ============================================
# YouTube Transcription API - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# cp env.example .env

# ============================================
# API Configuration
# ============================================
API_TITLE=YouTube Transcription API
API_VERSION=v1

# ============================================
# Billing / Credits (OFF by default)
# ============================================
# Master switch for the credits + Stripe billing system.
# false (default): every signed-in user has UNLIMITED transcription, no Stripe needed.
# true: users are charged against credits; you must configure Stripe + the DB below.
BILLING_ENABLED=false

# Owner Accounts (Unlimited Minutes — only relevant when BILLING_ENABLED=true)
# ============================================
# Comma-separated emails that always get unlimited transcription (no credit deductions)
# Example: OWNER_EMAILS=owner@example.com,admin@example.com
OWNER_EMAILS=

# ============================================
# Database (Postgres — required for sign-in, history, and billing)
# ============================================
# Any Postgres works; a free Neon database (https://neon.tech) is easiest.
# Create a project, copy its connection string, paste it here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ============================================
# Residential Proxy (optional — only needed for Instagram / some TikTok)
# ============================================
# Webshare (https://www.webshare.io) residential proxy API key. Leave empty to skip;
# YouTube and most TikTok still work without it.
WEBSHARE_API_KEY=

# ============================================
# RunPod Serverless Endpoint (for Whisper ASR on uploads / non-caption media)
# ============================================
# Your serverless endpoint id (in addition to RUNPOD_API_KEY above).
RUNPOD_ENDPOINT_ID=

# ============================================
# Stripe (optional — only when BILLING_ENABLED=true)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ============================================
# Security & Authentication
# ============================================
# API Keys: Comma-separated list of valid API keys for Bearer token authentication
# GENERATE THESE YOURSELF using: make api-key  or  python3 scripts/generate_api_key.py
# Example: API_KEYS=key1,key2,key3
# If empty, all requests are allowed (development mode only - NOT for production!)
API_KEYS=

# Secret Key: Used for JWT token signing (if you add JWT features later)
# GENERATE THIS YOURSELF using: python3 scripts/generate_secret_key.py
# Or run: make setup  (automatically generates both API_KEYS and SECRET_KEY)
# REQUIRED in production - leave empty will cause warnings
SECRET_KEY=

# CORS Origins: Comma-separated list of allowed origins
# Use * for all (development only - NOT recommended for production!)
# Example: CORS_ORIGINS=https://example.com,https://app.example.com
CORS_ORIGINS=*

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per API key per minute
RATE_LIMIT_PER_MINUTE=60

# ============================================
# YouTube Configuration
# ============================================

# ============================================
# ASR Configuration (Plan B - Whisper Fallback)
# ============================================
# Whisper Model: Hugging Face model ID
# Options: openai/whisper-base, openai/whisper-small, openai/whisper-medium, openai/whisper-large-v3
# This model will be automatically downloaded on first Docker container start if not present
WHISPER_MODEL=openai/whisper-base

# Whisper Model Path: Local path to pre-downloaded model (optional, for Docker volumes)
# If set, model will be loaded from this path instead of downloading from Hugging Face
# For Docker: Use /app/models/whisper (container path) - models are stored in Docker volumes
# Docker volumes persist models across container restarts, avoiding re-downloads
# Docker entrypoint automatically downloads model here on first start if not present
# To manually download: python scripts/download_whisper_model.py
# Default (if empty): /app/models/whisper (automatically set by docker-entrypoint.sh)
WHISPER_MODEL_PATH=

# Whisper Device: Compute device for Whisper
# Options: cpu, cuda (GPU), mps (Mac Metal Performance Shaders)
WHISPER_DEVICE=cpu

# Whisper Compute Type: Precision for model inference
# Options: float32 (CPU), float16 (GPU), int8 (quantized)
WHISPER_COMPUTE_TYPE=float32

# Max Video Duration: Maximum video duration in seconds (default: 1 hour)
# Videos longer than this will be rejected with VIDEO_TOO_LONG error
MAX_VIDEO_DURATION_SECONDS=3600

# Async Threshold: Videos longer than this duration (in seconds) are rejected for ASR processing
# Videos shorter than this are processed synchronously
# Default: 300 seconds (5 minutes)
ASYNC_THRESHOLD_SECONDS=300

# yt-dlp Timeout: Download timeout in seconds
YT_DLP_TIMEOUT=300

# Temp Audio Directory: Directory for temporary audio files
# Use ./temp_audio for local development, /app/temp_audio for Docker
TEMP_AUDIO_DIR=./temp_audio

# Temp Store Directory: Directory for storing full job results (JSON files)
# Full results are stored here, while minimal metadata is stored in Redis
# Use ./temp_store for local development, /app/temp_store for Docker
# Later this can be migrated to S3
TEMP_STORE_DIR=./temp_store

# Job TTL: Job results time-to-live in seconds (default: 1 hour)
JOB_TTL_SECONDS=3600

# ============================================
# Redis Configuration (Production Job Storage)
# ============================================
# Enable Redis for persistent job storage (recommended for production)
# If disabled, jobs are stored in-memory only (lost on restart)
REDIS_ENABLED=true

# Redis connection settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Redis Password: REQUIRED for all environments (dev and production)
# 
# Development: Set a password (can be simple like "dev-redis-password")
# Production: MUST set a strong password (32+ characters recommended)
# 
# Generate a secure password:
#   openssl rand -base64 32
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# If not set, dev environment will use default: "dev-redis-password-change-me"
# (You should change this!)
#
# Redis will require this password for all connections
REDIS_PASSWORD=dev-redis-password-change-me

# Redis connection timeouts (seconds)
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Redis UI Configuration (Redis Commander)
# Username for Redis UI web interface
REDIS_UI_USER=admin
# Password for Redis UI web interface
REDIS_UI_PASSWORD=admin

# ============================================
# Media Upload & Download Settings
# ============================================
# Max File Size: Maximum file size for uploads in megabytes (default: 500MB)
MAX_FILE_SIZE_MB=500
# Download Chunk Size: Chunk size in bytes for streaming downloads (default: 8192 = 8KB)
DOWNLOAD_CHUNK_SIZE=8192
# Max URL Query Length: Maximum length of URL query parameters in characters (default: 2000)
MAX_URL_QUERY_LENGTH=2000
# Max File Extension Length: Maximum length of file extension in characters (default: 10)
MAX_FILE_EXTENSION_LENGTH=10
# Media Download Timeout: Timeout for media download requests in seconds (default: 300 = 5 minutes)
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300

# ============================================
# Cache Configuration
# ============================================
# Cache Max Size: Maximum number of entries in captions cache (default: 1000)
CACHE_MAX_SIZE=1000
# Cache TTL Seconds: Time-to-live for captions cache in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300
# Video ID Cache Max Size: Maximum number of entries in video ID cache (default: 5000)
VIDEO_ID_CACHE_MAX_SIZE=5000
# Video ID Cache TTL Seconds: Time-to-live for video ID cache in seconds (default: 3600 = 1 hour)
VIDEO_ID_CACHE_TTL_SECONDS=3600
# Cache Warning Threshold: Cache size warning threshold (0.0-1.0). Warns when cache reaches this percentage
CACHE_WARNING_THRESHOLD=0.8

# ============================================
# Webhook Configuration
# ============================================
# Webhook Timeout: Timeout for webhook callback requests in seconds (default: 10)
WEBHOOK_TIMEOUT_SECONDS=10
# Webhook Max Retries: Maximum number of retry attempts for failed webhook callbacks (default: 3)
WEBHOOK_MAX_RETRIES=3
# Webhook Retry Backoff Base: Base delay in seconds for exponential backoff in webhook retries (default: 1.0)
WEBHOOK_RETRY_BACKOFF_BASE=1.0
# Webhook Connect Timeout: Connection timeout for webhook requests in seconds (default: 5.0)
WEBHOOK_CONNECT_TIMEOUT=5.0
# Webhook Write Timeout: Write timeout for webhook requests in seconds (default: 5.0)
WEBHOOK_WRITE_TIMEOUT=5.0
# Webhook Pool Timeout: Connection pool timeout for webhook requests in seconds (default: 5.0)
WEBHOOK_POOL_TIMEOUT=5.0
# Webhook User Agent: User-Agent string for webhook requests (default: TranscriptionService/1.0)
WEBHOOK_USER_AGENT=TranscriptionService/1.0

# ============================================
# Validation & Display Settings
# ============================================
# Max URL Length: Maximum URL length (characters)
MAX_URL_LENGTH=2048
# YouTube API Timeout: Timeout for YouTube Transcript API requests (seconds)
YOUTUBE_API_TIMEOUT=30
# Rate Limit Default Retry After: Default retry-after time in seconds for rate limit errors (default: 60)
RATE_LIMIT_DEFAULT_RETRY_AFTER=60
# Max Languages Display: Maximum number of languages to display in logs/errors before truncating (default: 10)
MAX_LANGUAGES_DISPLAY=10
# Min Text Length For Detection: Minimum text length in characters required for language detection (default: 10)
MIN_TEXT_LENGTH_FOR_DETECTION=10
# Log Result Sample Length: Maximum length of result sample to log for debugging (characters, default: 500)
LOG_RESULT_SAMPLE_LENGTH=500

# ============================================
# Whisper Confidence Calculation Thresholds
# ============================================
# These settings control how confidence scores are calculated for Whisper transcriptions
# Whisper Segment Density Optimal Min: Minimum optimal segment density (segments per second)
WHISPER_SEGMENT_DENSITY_OPTIMAL_MIN=2.0
# Whisper Segment Density Optimal Max: Maximum optimal segment density (segments per second)
WHISPER_SEGMENT_DENSITY_OPTIMAL_MAX=5.0
# Whisper Segment Density Max: Maximum segment density before confidence penalty
WHISPER_SEGMENT_DENSITY_MAX=10.0
# Whisper Gap Score Small: Small gap threshold in seconds for gap score calculation
WHISPER_GAP_SCORE_SMALL=2.0
# Whisper Gap Score Medium: Medium gap threshold in seconds for gap score calculation
WHISPER_GAP_SCORE_MEDIUM=5.0
# Whisper Gap Score Large: Large gap threshold in seconds for gap score calculation
WHISPER_GAP_SCORE_LARGE=10.0
# Whisper Word Length Optimal Min: Minimum optimal word length for confidence calculation
WHISPER_WORD_LENGTH_OPTIMAL_MIN=3.0
# Whisper Word Length Optimal Max: Maximum optimal word length for confidence calculation
WHISPER_WORD_LENGTH_OPTIMAL_MAX=6.0
# Whisper Word Length Short: Short word length threshold for confidence calculation
WHISPER_WORD_LENGTH_SHORT=2.0
# Whisper Word Length Long: Long word length threshold for confidence calculation
WHISPER_WORD_LENGTH_LONG=10.0

# ============================================
# Media Format Configuration
# ============================================
# Allowed Audio Formats: Comma-separated list of allowed audio format extensions (default: mp3,wav,m4a,flac,ogg)
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,flac,ogg
# Allowed Video Formats: Comma-separated list of allowed video format extensions (default: mp4,mkv,avi,mov,webm)
ALLOWED_VIDEO_FORMATS=mp4,mkv,avi,mov,webm
# Default File Extension: Default file extension to use when extension cannot be determined from URL (default: mp4)
DEFAULT_FILE_EXTENSION=mp4

# ============================================
# Whisper Confidence Calculation Weights
# ============================================
# These settings control the weights used in confidence score calculation
# Whisper Confidence Coverage Weight: Weight for coverage ratio in confidence calculation (default: 0.4)
WHISPER_CONFIDENCE_COVERAGE_WEIGHT=0.4
# Whisper Confidence Density Weight: Weight for density score in confidence calculation (default: 0.2)
WHISPER_CONFIDENCE_DENSITY_WEIGHT=0.2
# Whisper Confidence Text Quality Weight: Weight for text quality metrics in confidence calculation (default: 0.2)
WHISPER_CONFIDENCE_TEXT_QUALITY_WEIGHT=0.2
# Whisper Confidence Gap Weight: Weight for gap score in confidence calculation (default: 0.2)
WHISPER_CONFIDENCE_GAP_WEIGHT=0.2
# Whisper Text Quality Punctuation Weight: Weight for punctuation ratio within text quality (default: 0.5)
WHISPER_TEXT_QUALITY_PUNCTUATION_WEIGHT=0.5
# Whisper Text Quality Capitalization Weight: Weight for capitalization ratio within text quality (default: 0.3)
WHISPER_TEXT_QUALITY_CAPITALIZATION_WEIGHT=0.3
# Whisper Text Quality Word Length Weight: Weight for word length score within text quality (default: 0.2)
WHISPER_TEXT_QUALITY_WORD_LENGTH_WEIGHT=0.2
# Whisper Density Penalty Divisor: Divisor for density penalty calculation when density exceeds max (default: 20.0)
WHISPER_DENSITY_PENALTY_DIVISOR=20.0
# Whisper Density Interpolation Multiplier: Multiplier for density interpolation when density is below optimal min (default: 0.5)
WHISPER_DENSITY_INTERPOLATION_MULTIPLIER=0.5
# Whisper Word Length Short Score: Confidence score for short words (below short threshold) (default: 0.5)
WHISPER_WORD_LENGTH_SHORT_SCORE=0.5
# Whisper Gap Score Very Large: Gap score for very large gaps (above large threshold) (default: 0.4)
WHISPER_GAP_SCORE_VERY_LARGE=0.4

# ============================================
# Form Field Validation
# ============================================
# Max Translate To Length: Maximum length for translateTo form field (ISO 639-1 codes are 2-3 chars, allow some buffer)
MAX_TRANSLATE_TO_LENGTH=10
# Max Format Length: Maximum length for format form field (format names are short)
MAX_FORMAT_LENGTH=10
# Max Diarise Length: Maximum length for diarise form field ('true' or 'false')
MAX_DIARISE_LENGTH=5

# ============================================
# Language Code Validation
# ============================================
# Min Language Code Length: Minimum length for language codes (ISO 639-1 standard)
MIN_LANGUAGE_CODE_LENGTH=2
# Max Language Code Length: Maximum length for language codes (ISO 639-1 with variants like 'zh-Hans')
MAX_LANGUAGE_CODE_LENGTH=5

# ============================================
# YouTube Video ID Validation
# ============================================
# YouTube Video ID Length: YouTube video ID length (YouTube standard is exactly 11 characters)
YOUTUBE_VIDEO_ID_LENGTH=11

# ============================================
# Redis Configuration
# ============================================
# Redis Key Prefix: Prefix for Redis keys (default: job:)
REDIS_KEY_PREFIX=job:

# ============================================
# File Storage Configuration
# ============================================
# Result File Extension: File extension for result files (default: json)
RESULT_FILE_EXTENSION=json

# ============================================
# Preferred Languages for Captions
# ============================================
# Preferred Languages: Comma-separated list of preferred languages for YouTube captions (ISO 639-1 codes)
PREFERRED_LANGUAGES=en,es,fr,de,it,pt,ru
# Common Languages: Comma-separated list of common languages for YouTube captions fallback (ISO 639-1 codes)
COMMON_LANGUAGES=en,es,fr,de,it,pt,ru,ja,ko,zh-Hans,zh-Hant

# ============================================
# Whisper Confidence Calculation Additional Constants
# ============================================
# Whisper Segment End Offset: Offset in seconds to add to segment start when end is invalid (default: 0.1)
WHISPER_SEGMENT_END_OFFSET=0.1
# Whisper Word Length Long Score: Confidence score for long words (above long threshold) (default: 0.7)
WHISPER_WORD_LENGTH_LONG_SCORE=0.7
# Whisper Word Length Medium Score: Confidence score for medium word length (between short and optimal) (default: 0.8)
WHISPER_WORD_LENGTH_MEDIUM_SCORE=0.8
# Whisper Gap Score Single Segment: Gap score for single segment (can't assess gaps) (default: 0.9)
WHISPER_GAP_SCORE_SINGLE_SEGMENT=0.9
# Whisper Gap Score Medium Value: Gap score for medium gaps (between small and medium threshold) (default: 0.8)
WHISPER_GAP_SCORE_MEDIUM_VALUE=0.8
# Whisper Gap Score Large Value: Gap score for large gaps (between medium and large threshold) (default: 0.6)
WHISPER_GAP_SCORE_LARGE_VALUE=0.6
# Whisper Density Interpolation Factor: Factor for density interpolation when density is between optimal_max and max (default: 0.1)
WHISPER_DENSITY_INTERPOLATION_FACTOR=0.1
# Whisper Gap Score Between Medium Large: Gap score for gaps between medium and large threshold (default: 0.6)
WHISPER_GAP_SCORE_BETWEEN_MEDIUM_LARGE=0.6

# ============================================
# Level 3: S3 Storage Configuration (Local Testing)
# ============================================
# Enable S3-compatible storage (MinIO for local testing)
S3_ENABLED=true
# S3 Bucket Name: Name of the S3 bucket (create in MinIO console)
S3_BUCKET_NAME=transcription-storage
# S3 Region: AWS region (default: us-east-1)
S3_REGION=us-east-1
# S3 Access Key ID: MinIO access key (default: minioadmin)
S3_ACCESS_KEY_ID=minioadmin
# S3 Secret Access Key: MinIO secret key (default: minioadmin)
S3_SECRET_ACCESS_KEY=minioadmin
# S3 Endpoint URL: MinIO endpoint for local testing
# Use http://minio:9000 for Docker, http://localhost:9000 for local access
S3_ENDPOINT_URL=http://minio:9000
# S3 Media Prefix: Prefix for media files in S3 (default: media/)
S3_MEDIA_PREFIX=media/
# S3 Results Prefix: Prefix for transcription results in S3 (default: results/)
S3_RESULTS_PREFIX=results/
# S3 Multipart Threshold MB: File size threshold for multipart uploads (default: 100MB)
S3_MULTIPART_THRESHOLD_MB=100
# S3 Multipart Chunk Size MB: Chunk size for multipart uploads (default: 10MB)
S3_MULTIPART_CHUNK_SIZE_MB=10

# ============================================
# Level 3: MinIO Configuration (Local S3)
# ============================================
# MinIO Root User: Admin username for MinIO console (default: minioadmin)
MINIO_ROOT_USER=minioadmin
# MinIO Root Password: Admin password for MinIO console (default: minioadmin)
MINIO_ROOT_PASSWORD=minioadmin

# ============================================
# Level 3: Grafana Configuration (Metrics Visualization)
# ============================================
# Grafana Admin User: Admin username for Grafana (default: admin)
GRAFANA_ADMIN_USER=admin
# Grafana Admin Password: Admin password for Grafana (default: admin)
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# Level 3: Observability Configuration
# ============================================
# Observability Enabled: Enable structured logging and metrics (default: True)
OBSERVABILITY_ENABLED=true
# Log Format: Log format - 'json' (structured) or 'text' (default: json)
LOG_FORMAT=json
# Log Level: Logging level - DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# Metrics Enabled: Enable Prometheus metrics collection (default: True)
METRICS_ENABLED=true
# Metrics Port: Port for Prometheus metrics endpoint (default: 9090)
METRICS_PORT=9090

# ============================================
# Level 3: RunPod GPU Workers Configuration
# ============================================
# RunPod API Key: API key for RunPod service (REQUIRED for GPU workers)
# Get your API key from: https://www.runpod.io/console/user/settings
# Example: RUNPOD_API_KEY=your-runpod-api-key-here
RUNPOD_API_KEY=

# RunPod Template ID: Template ID for GPU worker pods (REQUIRED for GPU workers)
# Create a template in RunPod console and use its ID
# Example: RUNPOD_TEMPLATE_ID=abc123xyz
RUNPOD_TEMPLATE_ID=

# RunPod API URL: RunPod GraphQL API endpoint (default: https://api.runpod.io/graphql)
# Usually you don't need to change this
RUNPOD_API_URL=https://api.runpod.io/graphql

# Max Workers: Maximum number of concurrent GPU workers (default: 5)
MAX_WORKERS=5

# Min Workers: Minimum number of GPU workers to keep running (default: 0)
MIN_WORKERS=0

# Worker Idle Timeout: Idle timeout in seconds before shutting down a worker (default: 300 = 5 minutes)
WORKER_IDLE_TIMEOUT_SECONDS=300

# Worker Heartbeat Interval: Interval in seconds for worker heartbeat checks (default: 30)
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# Worker Health Check Timeout: Timeout in seconds for worker health checks (default: 120 = 2 minutes)
# Workers that don't send heartbeat within this time are marked as unhealthy
WORKER_HEALTH_CHECK_TIMEOUT_SECONDS=120

# Worker Auto-Scaling Configuration
# Worker Auto Scaling Enabled: Enable automatic worker scaling based on queue depth (default: True)
WORKER_AUTO_SCALING_ENABLED=true

# Worker Scale Up Queue Depth: Queue depth threshold to trigger worker scale-up (default: 10)
# When queue depth exceeds this value, a new worker will be created (up to MAX_WORKERS)
WORKER_SCALE_UP_QUEUE_DEPTH=10

# Worker Scale Down Queue Depth: Queue depth threshold to trigger worker scale-down (default: 2)
# When queue depth is below this value AND worker is idle > WORKER_IDLE_TIMEOUT_SECONDS, worker will be terminated
WORKER_SCALE_DOWN_QUEUE_DEPTH=2

# Worker Auto Scaling Interval: Interval in seconds for auto-scaling checks (default: 60)
WORKER_AUTO_SCALING_INTERVAL_SECONDS=60

# ============================================
# NOTES:
# ============================================
# 1. API_KEYS are for YOUR API authentication
#    - Used to protect YOUR transcription API endpoint
#    - Clients must send: Authorization: Bearer <API_KEY>
#    - If empty, anyone can use your API (dev mode only!)
#
# 2. SECRET_KEY is for JWT signing (future feature)
#    - Not currently used, but set it for future compatibility
#
# 3. LOCAL TESTING WITH MINIO:
#    - Start services: docker-compose -f docker-compose.dev.yml up
#    - Access MinIO Console: http://localhost:9001 (login with MINIO_ROOT_USER/MINIO_ROOT_PASSWORD)
#    - Create bucket: Use MinIO console to create bucket named S3_BUCKET_NAME
#    - Configure S3_ENABLED=true and S3_ENDPOINT_URL=http://minio:9000 in .env
#
# 4. METRICS & MONITORING:
#    - Prometheus: http://localhost:9090
#    - Grafana: http://localhost:3000 (login with GRAFANA_ADMIN_USER/GRAFANA_ADMIN_PASSWORD)
#    - API Metrics: http://localhost:8000/v1/metrics
#
# 5. RUNPOD GPU WORKERS:
#    - Get API key: https://www.runpod.io/console/user/settings
#    - Create template in RunPod console with your worker Docker image
#    - Test connection: python scripts/test_runpod_connection.py
#    - Or via API: GET /v1/workers/test-connection (requires API key)
#    - In Docker: docker run -e RUNPOD_API_KEY='your-key' ... python scripts/test_runpod_connection.py

